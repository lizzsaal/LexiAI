{
  "manifest_version": 3,
  "name": "LexiAI - Grammar Checker",
  "version": "3.0",
  "description": "Local grammar checking via LanguageTool + Llama 3",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:8010/*",
    "http://localhost:8081/*",
    "http://localhost:11434/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}